      "events": [
        {
          "id": "ed.ship.event.legalState",
          "type": "communicate",
          "name": "When the Legal State changes",
          "format": "When the Legal State becomes $val",
          "valueType": "choice",
          "valueChoices": [
            "Clean",
            "IllegalCargo",
            "Speeding",
            "Wanted",
            "Hostile",
            "PassengerWanted",
            "Warrant"
          ],
          "valueStateId": "ed.ship.legalState"
        },
        {
          "id": "ed.ship.event.guiFocus",
          "type": "communicate",
          "name": "When the Focused Panel changes",
          "format": "When the Focused Panel becomes $val",
          "valueType": "choice",
          "valueChoices": [
            "NoFocus",
            "InternalPanel",
            "ExternalPanel",
            "CommsPanel",
            "RolePanel",
            "StationServices",
            "GalaxyMap",
            "SystemMap",
            "Orrery",
            "FSS mode",
            "SAA mode",
